# PC Assessment - Short Link Launcher
# The source lives under ShortLinks\ because Windows cannot have both an Assess folder and
# a case-insensitive "assess" file in the repository root. The release workflow publishes
# this file as /assess in the JLESC2026.github.io repository.
#
# Recommended command (works on Windows PowerShell 5.1 and 7, any TLS default):
#   [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $r=(iwr -UseBasicParsing https://jlesc2026.github.io/assess).Content; if($r -is [byte[]]){$r=[Text.Encoding]::UTF8.GetString($r)}; iex $r.TrimStart([char]0xFEFF)
#
# How it runs: this launcher asks for administrator rights FIRST. The elevated copy then downloads the
# assessment from a published release, checks its SHA-256 hash against
# https://jlesc2026.github.io/manifest.json, and runs it from a new, randomly named, administrators-only
# folder under C:\ProgramData - never from %TEMP%, which a standard user can write to.
# The folder is deleted afterwards and the deletion is verified. The HTML report contains the computer name,
# user, serial number and MAC addresses, so the launcher ASKS where it should go: a folder or USB drive you
# choose, the Desktop, or 'show it, then delete it'. To skip the question set $env:ITTK_ASSESS_OUT to a folder first.

$PayloadOwner = 'JLESC2026'
$PayloadRepo  = 'IT-Tech-Support-Tool-Kit'

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch { }

if ($env:OS -ne 'Windows_NT') {
    Write-Host '[ASSESS] This assessment runs on Windows only.' -ForegroundColor Red
    return
}

$selfUrl       = 'https://jlesc2026.github.io/assess'
$manifestUrl   = 'https://jlesc2026.github.io/manifest.json'
$releasePrefix = "https://github.com/$PayloadOwner/$PayloadRepo/releases/download/"
$workPrefix    = 'ITTK_assess'

function Write-Step { param([string]$m) Write-Host "[ASSESS] $m" -ForegroundColor Cyan }
function Write-StepWarn { param([string]$m) Write-Host "[ASSESS] WARNING: $m" -ForegroundColor Yellow }

function Read-ReportChoice {
    Write-Host ''
    Write-Host '[ASSESS] The report contains the computer name, user name, serial number and MAC addresses.' -ForegroundColor Yellow
    while ($true) {
        Write-Host '  [1] Save it to a folder or USB drive I choose'
        Write-Host '  [2] Save it to this PC''s Desktop (it stays there until you delete it)'
        Write-Host '  [3] Just show it to me, then delete it'
        $ans = (Read-Host 'Where should the report go? Choose 1, 2 or 3').Trim()
        if ($ans -eq '1') {
            $picked = $null
            try {
                Add-Type -AssemblyName System.Windows.Forms -ErrorAction Stop
                $owner = New-Object System.Windows.Forms.Form
                $owner.TopMost = $true; $owner.ShowInTaskbar = $false; $owner.WindowState = 'Minimized'; $owner.Show()
                $dlg = New-Object System.Windows.Forms.FolderBrowserDialog
                $dlg.Description = 'Choose a folder or USB drive for the assessment report'
                if ($dlg.ShowDialog($owner) -eq [System.Windows.Forms.DialogResult]::OK) { $picked = $dlg.SelectedPath }
                $owner.Dispose()
            } catch {
                $picked = (Read-Host 'Type a drive or folder path (for example E:\)').Trim().Trim('"')
            }
            if ($picked -and (Test-Path -LiteralPath $picked -PathType Container)) {
                return [pscustomobject]@{ Path = $picked; DeleteAfter = $false }
            }
            Write-Host 'No usable folder chosen.' -ForegroundColor Yellow
        } elseif ($ans -eq '2') {
            $d = [Environment]::GetFolderPath('Desktop')
            if (-not $d -or -not (Test-Path -LiteralPath $d -PathType Container)) { $d = Join-Path $env:USERPROFILE 'Documents' }
            return [pscustomobject]@{ Path = $d; DeleteAfter = $false }
        } elseif ($ans -eq '3') {
            $t = Join-Path $env:TEMP ('ITTK_report_' + [guid]::NewGuid().ToString('N'))
            New-Item -ItemType Directory -Path $t | Out-Null
            return [pscustomobject]@{ Path = $t; DeleteAfter = $true }
        }
    }
}

# Asks the user to finish viewing, then deletes the one-off report folder and says whether it worked.
function Remove-ViewOnlyReport {
    param([string]$Path, [bool]$Ask)
    if (-not (Test-Path -LiteralPath $Path)) { return }
    # Safety: only ever delete the one-off folder this launcher created in %TEMP%.
    $leaf = Split-Path -Leaf $Path
    $parent = (Split-Path -Parent $Path).TrimEnd('\')
    if ($leaf -notlike 'ITTK_report_*' -or $parent -ne ([string]$env:TEMP).TrimEnd('\')) { return }
    if ($Ask -and @(Get-ChildItem -LiteralPath $Path -Force -ErrorAction SilentlyContinue).Count -gt 0) {
        Write-Host "[ASSESS] The report is in: $Path" -ForegroundColor Cyan
        Read-Host 'Press Enter when you have finished viewing it, and it will be deleted' | Out-Null
    }
    try { Remove-Item -LiteralPath $Path -Recurse -Force -ErrorAction Stop } catch { }
    if (Test-Path -LiteralPath $Path) { Write-StepWarn "Could not delete the report folder: $Path" }
    elseif ($Ask) { Write-Step 'The report was deleted.' }
}

# ---------- Where does the report go? (asked once, before anything is downloaded) ----------
$id = [Security.Principal.WindowsIdentity]::GetCurrent()
$isAdmin = (New-Object Security.Principal.WindowsPrincipal($id)).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
$outDir = $env:ITTK_ASSESS_OUT
$deleteAfter = $false
if (-not $outDir) {
    $choice = Read-ReportChoice
    $outDir = $choice.Path
    $deleteAfter = $choice.DeleteAfter
}

# ---------- Elevate first: nothing is downloaded or run by the unelevated copy ----------
if (-not $isAdmin) {
    Write-Step 'Requesting administrator elevation...'
    try {
        $safeOut = ([string]$outDir).Replace("'", "''")
        $boot = "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; " +
                "`$env:ITTK_ASSESS_OUT='$safeOut'; " +
                "`$r=(Invoke-WebRequest -UseBasicParsing '$selfUrl').Content; " +
                "if(`$r -is [byte[]]){`$r=[Text.Encoding]::UTF8.GetString(`$r)}; " +
                "Invoke-Expression `$r.TrimStart([char]0xFEFF)"
        $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($boot))
        $psExe = (Get-Process -Id $PID).Path
        Start-Process -FilePath $psExe -Verb RunAs -Wait -ArgumentList "-NoProfile -ExecutionPolicy Bypass -EncodedCommand $enc"
    } catch {
        Write-Host "[ASSESS] Elevation cancelled or blocked: $($_.Exception.Message)" -ForegroundColor Red
    }
    if ($deleteAfter) { Remove-ViewOnlyReport -Path $outDir -Ask $true }
    return
}

# ---------- Everything below runs elevated ----------
function Get-WebText {
    param([string]$Url)
    $r = (Invoke-WebRequest -UseBasicParsing -Uri $Url).Content
    if ($r -is [byte[]]) { $r = [Text.Encoding]::UTF8.GetString($r) }
    return ([string]$r).TrimStart([char]0xFEFF)
}

function Test-TrustedOwner {
    param([string]$Path)
    try {
        $sid = (Get-Acl -LiteralPath $Path -ErrorAction Stop).GetOwner([Security.Principal.SecurityIdentifier]).Value
    } catch { return $false }
    $allowed = @('S-1-5-18', 'S-1-5-32-544', [Security.Principal.WindowsIdentity]::GetCurrent().User.Value)
    return ($allowed -contains $sid)
}

function New-SecureWorkFolder {
    $path = Join-Path $env:ProgramData ($workPrefix + '_' + [guid]::NewGuid().ToString('N'))
    if (Test-Path -LiteralPath $path) { throw 'Refusing to use a working folder that already exists.' }
    New-Item -ItemType Directory -Path $path | Out-Null   # no -Force on purpose: it must be new
    $me = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
    & icacls.exe $path /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' "*${me}:(OI)(CI)F" | Out-Null
    if ($LASTEXITCODE -ne 0) { throw "Could not restrict access to the working folder (icacls exit code $LASTEXITCODE)." }
    & attrib.exe +h +s $path | Out-Null
    $item = Get-Item -LiteralPath $path -Force
    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'The working folder is a reparse point (junction or link). Stopped.' }
    if (-not (Test-TrustedOwner $path)) { throw 'The working folder is not owned by SYSTEM, Administrators or you. Stopped.' }
    return $path
}

# Deletes a folder tree without ever following a junction or symbolic link.
function Remove-TreeSafe {
    param([string]$Path)
    $di = New-Object System.IO.DirectoryInfo $Path
    if (-not $di.Exists) { return }
    if ($di.Attributes -band [IO.FileAttributes]::ReparsePoint) {
        try { [System.IO.Directory]::Delete($Path) } catch { $script:CleanupErrors += "$Path : $($_.Exception.Message)" }
        return
    }
    foreach ($e in @($di.GetFileSystemInfos())) {
        try {
            if ($e.Attributes -band [IO.FileAttributes]::ReparsePoint) {
                if ($e -is [System.IO.DirectoryInfo]) { [System.IO.Directory]::Delete($e.FullName) }
                else { [System.IO.File]::Delete($e.FullName) }
            } elseif ($e -is [System.IO.DirectoryInfo]) {
                Remove-TreeSafe $e.FullName
            } else {
                $e.Attributes = [IO.FileAttributes]::Normal
                $e.Delete()
            }
        } catch { $script:CleanupErrors += "$($e.FullName) : $($_.Exception.Message)" }
    }
    try { $di.Attributes = [IO.FileAttributes]::Normal; $di.Delete() } catch { $script:CleanupErrors += "$Path : $($_.Exception.Message)" }
}

# Old assess_* folders in %TEMP% from the previous launcher version are not touched; only our own folders here.
function Remove-StaleRuns {
    $dirs = @(Get-ChildItem -LiteralPath $env:ProgramData -Directory -Force -Filter "$workPrefix*" -ErrorAction SilentlyContinue)
    foreach ($d in $dirs) {
        if ($d.Attributes -band [IO.FileAttributes]::ReparsePoint) { continue }
        if ($d.LastWriteTime -gt (Get-Date).AddMinutes(-15)) { continue }
        if (-not (Test-TrustedOwner $d.FullName)) { continue }
        $script:CleanupErrors = @()
        Remove-TreeSafe $d.FullName
    }
}

# Report folder: chosen above (or handed over by the unelevated copy), checked to be a real folder (not a link).
Remove-Item Env:\ITTK_ASSESS_OUT -ErrorAction SilentlyContinue
if (-not $outDir -or -not (Test-Path -LiteralPath $outDir -PathType Container) -or
    ((Get-Item -LiteralPath $outDir -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) {
    $deleteAfter = $false   # never delete a fallback folder
    $outDir = [Environment]::GetFolderPath('Desktop')
    if (-not $outDir -or -not (Test-Path -LiteralPath $outDir -PathType Container)) { $outDir = Join-Path $env:USERPROFILE 'Documents' }
}

$tmp = $null
$script:CleanupErrors = @()
try {
    Remove-StaleRuns
    $tmp = New-SecureWorkFolder
    $assessmentScript = Join-Path $tmp 'Assess.ps1'

    Write-Step 'Checking the published release...'
    try {
        $manifest = (Get-WebText $manifestUrl) | ConvertFrom-Json
    } catch {
        throw "Could not read the release manifest ($($_.Exception.Message)). Check internet/proxy/firewall access to jlesc2026.github.io. Nothing was run."
    }
    if ([int]$manifest.schema -ne 1 -or -not $manifest.assess -or -not $manifest.assess.url -or -not $manifest.assess.sha256) {
        throw 'The release manifest is not in the expected format. Nothing was run.'
    }
    $scriptUrl = [string]$manifest.assess.url
    if (-not $scriptUrl.StartsWith($releasePrefix, [StringComparison]::Ordinal)) {
        throw "The manifest points outside $releasePrefix - refusing to download. Nothing was run."
    }
    $expectedHash = ([string]$manifest.assess.sha256).Trim().ToLowerInvariant()
    if ($expectedHash -notmatch '^[0-9a-f]{64}$') { throw 'The manifest does not contain a valid SHA-256 value. Nothing was run.' }

    Write-Step "Downloading assessment $($manifest.version)..."
    Invoke-WebRequest -Uri $scriptUrl -OutFile $assessmentScript -UseBasicParsing
    if (-not (Test-Path -LiteralPath $assessmentScript) -or (Get-Item -LiteralPath $assessmentScript).Length -eq 0) {
        throw 'The downloaded assessment script is empty. Nothing was run.'
    }
    $actualHash = (Get-FileHash -LiteralPath $assessmentScript -Algorithm SHA256).Hash.ToLowerInvariant()
    if ($actualHash -ne $expectedHash) {
        throw "INTEGRITY CHECK FAILED: the download does not match the published SHA-256. Nothing was run. Expected $expectedHash but got $actualHash."
    }
    Write-Step "Integrity verified (SHA-256 $($actualHash.Substring(0, 16))...)."

    Write-Step 'Starting read-only assessment...'
    $ps = (Get-Process -Id $PID).Path
    $p = Start-Process -FilePath $ps -Wait -PassThru `
        -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$assessmentScript`" -OutDir `"$outDir`" -NoElevate -Pause"
    if ($p.ExitCode -ne 0) { throw "Assessment process exited with code $($p.ExitCode)." }
} catch {
    Write-Host "[ASSESS] Error: $($_.Exception.Message)" -ForegroundColor Red
    Read-Host 'Press Enter to close' | Out-Null
} finally {
    if ($tmp -and (Test-Path -LiteralPath $tmp)) {
        $script:CleanupErrors = @()
        Remove-TreeSafe $tmp
        if (Test-Path -LiteralPath $tmp) {
            Write-StepWarn "The temporary folder is still on this computer: $tmp"
            foreach ($err in @($script:CleanupErrors | Select-Object -First 5)) { Write-Host "         $err" -ForegroundColor Yellow }
            Write-Host '         It is removed at the start of the next run, or you can delete it yourself.' -ForegroundColor Yellow
        } else {
            Write-Step 'Cleanup verified: the temporary folder no longer exists.'
        }
    }
    if ($deleteAfter) { Remove-ViewOnlyReport -Path $outDir -Ask $true }
    elseif ($outDir) { Write-Step "The report was saved in: $outDir (it contains the serial number and MAC addresses)." }
}
